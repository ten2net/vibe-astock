{{- /* /atom.xml —— 标准 Atom 1.0（RFC 4287），固定文件名订阅源。
       Hugo 内置没有 Atom 模板，这里自己生成：<feed xmlns=...> + 每篇 <entry>。
       输出格式 ATOMXML 定义在 hugo.toml，用独立 mediaType 与内置 index.xml 隔离。
       ISO 8601 时间戳过 safeHTML，避免 "+08:00" 被转义成 "&#43;08:00"（Atom 要原样 +）。
*/ -}}
{{- $pages := first 20 (where .Site.RegularPages "Section" "post") -}}
{{- $updated := (index $pages 0).Date.Format "2006-01-02T15:04:05-07:00" -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ .Site.LanguageCode }}">
  <id>{{ .Site.BaseURL }}</id>
  <title>{{ .Site.Title }}</title>
  {{ with .Site.Params.description }}<subtitle>{{ . }}</subtitle>{{ end }}
  <updated>{{ $updated | safeHTML }}</updated>
  <link rel="self" type="application/atom+xml" href="{{ "atom.xml" | absURL }}" />
  <link rel="alternate" type="text/html" href="{{ .Site.BaseURL }}" />
  <generator uri="https://gohugo.io/" version="hugo">Hugo</generator>
  {{- range $pages }}
  <entry>
    <id>{{ .Permalink }}</id>
    <title>{{ .Title }}</title>
    <link rel="alternate" type="text/html" href="{{ .Permalink }}" />
    <published>{{ .Date.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</published>
    <updated>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</updated>
    <summary type="html">{{ .Summary | html }}</summary>
    {{- range .Params.tags }}<category term="{{ . }}" />{{ end }}
  </entry>
  {{- end }}
</feed>
