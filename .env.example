# Vibe-Astock —— 环境变量模板
#
# LLM 走 MiMo，凭据默认从 ~/.config/mimo/mimo.env 自动加载（不需要在这里重复填）。
# 只有当你想覆盖默认时才在下面设置：
#
# MIMO_API_KEY=...            # 切勿提交真实 key
# MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# MIMO_MODEL=mimo-v2.5-pro    # deep 档模型；quick 档写死 mimo-v2.5
#
# Agent-Reach（题材热点分析师用于印证题材的可选外部工具，走 mcporter/exa）：
# 不装也能跑 —— 题材分析师会退回只用涨停原因题材串，并在报告里说明少了这一路印证。
# 情绪面真实数据需要 akshare（pip install akshare）。
#
# 局域网 / 反向代理访问（默认只监听回环，两行都不需要）：
# 1) VIBE_HOST：让 uvicorn 绑到非回环地址。缺它，用局域网 IP 访问会直接「连接被拒绝」。
# 2) VIBE_ALLOW_HOSTS：访问用的 Host（逗号分隔）。缺它，请求进得来但全部接口 403。
#    127.0.0.1、::1 与 localhost 始终允许，不必写入。
TUSHARE_TOKEN=9dc63……
EASTMONEY_COOKIE="ct=X66MdePD; ut=FobyicMgeV73d_YCqk5XYK6q;"
VIBE_HOST=0.0.0.0
VIBE_ALLOW_HOSTS=192.168.15.131,192.168.200.24,192.168.200.12

# 代理（可选）：境外数据源走代理。
# 目前事件概率（Kalshi api.elections.kalshi.com / Polymarket gamma-api.polymarket.com）
# 经此代理能建隧道但 TLS 被掐，需要**代理端放行这两个域名**后才可取到数据。
# 国内源（东财、腾讯、百度）用 no_proxy 排除，不走代理 —— 否则会绕远且可能失败。
# 大小写都写一份：urllib/requests 读小写，部分 CLI 只读大写。
http_proxy=http://192.168.200.24:7890
https_proxy=http://192.168.200.24:7890
no_proxy=localhost,127.0.0.1,192.168.15.131,192.168.200.24,.eastmoney.com,.qq.com,.baidu.com
HTTP_PROXY=http://192.168.200.24:7890
HTTPS_PROXY=http://192.168.200.24:7890
NO_PROXY=localhost,127.0.0.1,192.168.15.131,192.168.200.24,.eastmoney.com,.qq.com,.baidu.com
