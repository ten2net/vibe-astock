# Vibe AStock v2 —— 新版研究编排器容器（orchestrator + desktop + data-access）
#
# 与 Dockerfile（旧版 v1 应用）并存，互不影响：
#   docker compose build vibe-astock-v2 && docker compose up -d vibe-astock-v2
#
# 页面 5940 对外（远程模式，访问口令在卷 vibe-astock-v2-local 的 access.token），
# 本机 API 8770 只听容器回环，不对外。首次启动约十秒（页面在构建阶段已打好包）。

# ---------------------------------------------------------------- 构建阶段
FROM node:24-bookworm-slim AS build
WORKDIR /build

# npm 直连 registry.npmmirror.com 在本网络会 ECONNRESET，构建时带代理
ARG https_proxy
ARG http_proxy
ENV https_proxy=$https_proxy http_proxy=$http_proxy

COPY orchestrator/package.json orchestrator/package-lock.json ./orchestrator/
COPY desktop/package.json desktop/package-lock.json ./desktop/
RUN npm ci --prefix orchestrator --no-audit --no-fund \
 && npm ci --prefix desktop --no-audit --no-fund

COPY orchestrator/ ./orchestrator/
COPY desktop/ ./desktop/
RUN npm run build --prefix desktop

# ---------------------------------------------------------------- 运行阶段
FROM python:3.12-slim-bookworm

ARG NODE_VERSION=24.15.0
ARG https_proxy
ARG http_proxy
ENV https_proxy=$https_proxy http_proxy=$http_proxy \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    VRA_UI_PORT=5940 \
    VRA_API_PORT=8770

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl xz-utils ca-certificates procps \
 && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
    | tar -xJ -C /usr/local --strip-components=1 \
 && node --version && npm --version \
 && apt-get purge -y --auto-remove curl xz-utils \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Python 取数层依赖（新版 setup/doctor 认的就是这一份 requirements）
RUN python -m venv .venv
COPY .agents/skills/data-access/scripts/requirements.txt /tmp/data-access-requirements.txt
RUN .venv/bin/pip install --no-cache-dir -r /tmp/data-access-requirements.txt

COPY . .
COPY --from=build /build/desktop/dist ./desktop/dist
COPY --from=build /build/orchestrator/node_modules ./orchestrator/node_modules
COPY --from=build /build/desktop/node_modules ./desktop/node_modules

EXPOSE 5940

# 远程模式未带访问口令时根地址会回 401——能回 401 就说明页面服务活着
HEALTHCHECK --interval=30s --timeout=10s --retries=5 --start-period=90s \
    CMD node -e "fetch('http://127.0.0.1:5940/').then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"

# 入口脚本完成：幂等初始化 .local 私有层（init 不覆盖已有配置），再以远程模式常驻；
# VRA_PUBLIC_URL 给隧道域名拼访问链接（只用于拼链接，不是监听地址）
CMD ["sh", "scripts/docker-v2-start.sh"]
