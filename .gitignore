# 用户私有层:配置 / 运行产物 / 知识层私有档案,永不入库
.local/

# Python
# 不带斜杠：`.venv` 可能是符号链接，带斜杠只匹配目录会让符号链接漏网被当成 gitlink。
.venv
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
.vite/

# 旧版用户数据兜底：复盘数据落在 ~/.duanxian-agents/，万一有人把数据目录软链进来
.duanxian-agents/

# 环境与密钥
.env
.env.*
!.env.example
*.key
*.pem

# 系统与日志
.DS_Store
*.log
