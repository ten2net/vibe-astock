# 用户私有层:配置 / 运行产物 / 知识层私有档案,永不入库
.local/

# CodeBuddy 会话本地状态（定时任务等），不入库
.codebuddy/

# 头条自动发布运行产物（发布进度），不入库
wechat-article/publish_state.json

# 社媒导流产物（由 scripts/social_daily.py 生成，可随时重出）：
# 公众号二维码导流卡片 *-lead.png、雪球/东财股吧图文包、UTM 跳页。
# 注：cards/social/go 下历史产物已被 git 跟踪，本规则只让「新生成的」文件不入库。
blog/static/cards/*-lead.png
blog/static/cards/latest*-lead.png
blog/static/social/packs/
blog/static/go/

# Python
# 不带斜杠：`.venv` 可能是符号链接，带斜杠只匹配目录会让符号链接漏网被当成 gitlink。
.venv
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
.vite/

# 旧版用户数据兜底：复盘数据落在 ~/.duanxian-agents/，万一有人把数据目录软链进来
.duanxian-agents/

# 环境与密钥
.env
.env.*
!.env.example
*.key
*.pem

# 迁移私有文件包（含真实凭据，绝不入库；见 docs/迁移方案/迁移方案.md）
docs/迁移方案/vibe-astock-secrets-*.zip

# 系统与日志
.DS_Store
*.log

# 第三方采集 skill（SkillHub 安装产物，可重新安装，不入库）
skills/
